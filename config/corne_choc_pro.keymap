/*
 * Keymap for the Keebart Corne Choc Pro BT (46-position layout).
 *
 * Ported from the previous corne-config-zmk configuration: all 42 original
 * bindings of the four original layers are preserved verbatim. The four
 * additional middle positions of the Corne Choc Pro are inserted at rows 0
 * and 1, columns 6 and 7 (keymap indices 6, 7, 20 and 21):
 *
 *   - the left middle positions are not fitted on this build (&none)
 *   - the top-right middle key is a regular key (play/pause)
 *   - the bottom-right middle position is the push switch of the fitted
 *     lower-right rotary encoder (mute)
 *
 * The four sensor slots keep the vendor order (left_ex1, left_ex2,
 * right_ex1, right_ex2) and are all bound to volume; the rotation direction
 * follows the vendor default (C_VOL_DN first) and must be confirmed on the
 * physical board.
 *
 * A fifth layer (maintenance) is reachable only by holding the combo of the
 * top-right middle key (position 7) and the outer right thumb key
 * (position 45) on the default layer. Its keys sit on left-half positions
 * so they stay reachable while the right hand holds the combo.
 *
 * Copyright (c) 2020 The ZMK Contributors
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define LOWER 1
#define RAISE 2
#define NAV 3
#define MAINTENANCE 4

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    behaviors {
        htp: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        maintenance_combo {
            timeout-ms = <50>;
            key-positions = <7 45>;
            bindings = <&mo 4>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            // --------------------------------------------------------------------------------
            // | TAB  |   Q  |  W  |  F  |  P  |  G  | none |  PP   |  J  |  L  |  U  |  Y  |  ;  | ESC  |
            // | ALT  |   A  |  R  |  S  |  T  |  D  | none | MUTE  |  H  |  N  |  E  |  I  |  O  |  '   |
            // | SHIFT|   Z  |  X  |  C  |  V  |  B  |               |  K  |  M  |  ,  |  .  |  /  | LWR  |
            //                     | BSPC | CTRL | RET |  | RET | SPACE | NAV |
            bindings = <
 &kp TAB      &htp LS(Q) Q  &htp LS(W) W  &htp LS(F) F  &htp LS(P) P     &htp LS(G) G    &none              &kp C_PLAY_PAUSE    &htp LS(J) J  &htp LS(L) L  &htp LS(U) U     &htp LS(Y) Y      &htp LS(SEMI) SEMI  &kp ESC
 &kp LALT     &htp LS(A) A  &htp LS(R) R  &htp LS(S) S  &htp LS(T) T     &htp LS(D) D    &none              &kp C_MUTE          &htp LS(H) H  &htp LS(N) N  &htp LS(E) E     &htp LS(I) I      &htp LS(O) O        &htp LS(SQT) SQT
 &kp LSHFT    &htp LS(Z) Z  &htp LS(X) X  &htp LS(C) C  &htp LS(V) V     &htp LS(B) B                                           &htp LS(K) K  &htp LS(M) M  &htp SEMI COMMA  &htp LS(DOT) DOT  &htp LS(FSLH) FSLH  &mo 1
                                           &kp BSPC      &htp LCTRL BSPC  &kp RET         &kp RET       &lt 2 SPACE   &mo 3
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        system {
            display-name = "System";
            // --------------------------------------------------------------------------------
            // | F8  |  F1 |  F2 |  F3 |  F4 |none | none |trans |none |none |none |none | F2  | F8  |
            // | OUT |none |none |none |none |none | none |trans |none |trans| BRI+| BRI-|MIN  |none |
            // | BTCLR|BT0 | BT1 | BT2 | BT3 |none |               |none | VOL+| VOL-| MUTE|none |none |
            //                     |trans|trans|trans|  |trans|trans|trans|
            bindings = <
 &kp F8        &kp F1        &kp F2        &kp F3        &kp F4        &none           &none              &trans              &none         &none         &none         &none                &kp F2         &kp F8
 &out OUT_TOG  &none         &none         &none         &none         &none           &none              &trans              &none         &trans        &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &kp C_BRI_MIN  &none
 &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none           &none               &none              &kp C_VOLUME_UP   &kp C_VOLUME_DOWN  &kp K_MUTE     &none
                                           &trans        &trans        &trans    &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        symbols {
            display-name = "Symbols";
            // --------------------------------------------------------------------------------
            // |trans|  N1  |  N2 |  N3 |  N4 |  N5 | none |trans |  N6 |  N7 |  N8 |  N9 | N0  |trans|
            // | PIPE| EQU  |  {  |  (  |  :  |  `  | none |trans |PGUP|LEFT | UP  |DOWN |RGHT |trans|
            // |  /  |  >   |  +  |  _  |  -  |  ~  |               | PGDN| DEL |trans|trans|trans|trans|
            //                     |trans|trans|trans|  |trans|trans|trans|
            bindings = <
 &trans        &htp LS(N1) N1  &htp LS(N2) N2  &htp LS(N3) N3  &htp LS(N4) N4  &htp LS(N5) N5     &none              &trans              &htp LS(N6) N6  &htp LS(N7) N7  &htp LS(N8) N8  &htp LS(N9) N9   &htp LS(N0) N0  &trans
 &kp PIPE      &kp EQUAL        &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp COLON  &kp GRAVE           &none              &trans              &kp PG_UP       &kp LEFT        &kp UP          &kp DOWN        &kp RIGHT       &trans
 &kp SLASH     &kp GT           &kp PLUS        &kp UNDER            &kp MINUS  &kp TILDE                                                &kp PG_DN       &kp DEL         &trans          &trans          &trans          &trans
                                           &trans        &trans        &trans    &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        brackets {
            display-name = "Brackets";
            // --------------------------------------------------------------------------------
            // |trans|  N1  |  N2 |  N3 |  N4 |  N5 | none |trans |  N6 |  N7 |  N8 |  N9 | N0  |trans|
            // |  \  |  <   |  {  |  (  |  [  |trans| none |trans |PGUP|LEFT | UP  |DOWN |RGHT |trans|
            // |  /  |  >   |  }  |  )  |  ]  |trans|               |PGDN | DEL |trans|trans|trans|trans|
            //                     | GUI |trans|trans|  |trans|trans|trans|
            bindings = <
 &trans         &htp LS(N1) N1  &htp LS(N2) N2   &htp LS(N3) N3         &htp LS(N4) N4     &htp LS(N5) N5    &none              &trans              &htp LS(N6) N6  &htp LS(N7) N7  &htp LS(N8) N8  &htp LS(N9) N9  &htp LS(N0) N0  &trans
 &kp BACKSLASH  &kp LT          &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &kp LEFT_BRACKET   &trans            &none              &trans              &kp PAGE_UP     &kp LEFT        &kp UP          &kp DOWN        &kp RIGHT       &trans
 &kp SLASH      &kp GT          &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &trans                                                   &kp PAGE_DOWN   &kp DELETE      &trans          &trans          &trans          &trans
                                                 &kp LEFT_COMMAND       &trans             &trans            &trans    &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        maintenance {
            display-name = "Maintenance";
            // Maintenance layer, held via the pos 7 + pos 45 combo. Keys sit on
            // left-half positions (reachable while the right hand holds the
            // combo); everything else, including the two combo keys, is
            // transparent.
            //
            // --------------------------------------------------------------------------------
            // |trans|RESET|BOOT |UNLOCK|RGB_T|BT5  |trans|trans|trans|trans|trans|trans|trans|trans|
            // |trans|USB  | BLE | none |trans|trans|trans|trans|trans|trans|trans|trans|trans|trans|
            // |trans|trans|trans|trans|trans|trans|               |trans|trans|trans|trans|trans|trans|
            //                     |trans|trans|trans|  |trans|trans|trans|
            bindings = <
 &trans        &sys_reset    &bootloader   &studio_unlock  &rgb_ug RGB_TOG  &bt BT_SEL 4     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
 &trans        &out OUT_USB  &out OUT_BLE  &none           &trans           &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
 &trans        &trans        &trans        &trans          &trans           &trans                             &trans  &trans  &trans  &trans  &trans  &trans
                                           &trans          &trans           &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};